# ------------------------------------------------------------------
# Network Syslog Monitoring & Incident Correlation Platform
# Environment configuration — copy this file to `.env` before running:
#   cp .env.example .env
# ------------------------------------------------------------------

# Application ---------------------------------------------------------
APP_NAME="Network Syslog Monitoring & Incident Correlation Platform"
APP_VERSION=0.1.0
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# PostgreSQL ----------------------------------------------------------
POSTGRES_USER=syslog_user
POSTGRES_PASSWORD=syslog_password
POSTGRES_DB=syslog_db
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Optional: full SQLAlchemy URL (overrides the values above when set)
DATABASE_URL=

# Redis ---------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# Syslog listeners ----------------------------------------------------
# Master switch for the in-process UDP/TCP listeners
SYSLOG_LISTENERS_ENABLED=true
SYSLOG_UDP_HOST=0.0.0.0
SYSLOG_UDP_PORT=514
SYSLOG_TCP_HOST=0.0.0.0
SYSLOG_TCP_PORT=514
# TLS transport (RFC 5425 style) — wired in later, must be off for now
SYSLOG_TLS_ENABLED=false
SYSLOG_TLS_PORT=6514
# Ingestion pipeline tuning
SYSLOG_QUEUE_MAXSIZE=10000
SYSLOG_MAX_MESSAGE_BYTES=65536
SYSLOG_WORKER_COUNT=4

# Detection engine (Phase 2) ---------------------------------------------
DETECTION_ENABLED=true
# Link flap: N DOWN/UP transitions inside the window raise one alert
LINK_FLAP_WINDOW_SECONDS=300
LINK_FLAP_THRESHOLD=4
# Repeated failed logins per device+source inside the window
AUTH_FAILURE_WINDOW_SECONDS=300
AUTH_FAILURE_THRESHOLD=5
# Device performance thresholds (percent)
CPU_HIGH_THRESHOLD_PERCENT=90
MEMORY_HIGH_THRESHOLD_PERCENT=90

# Correlation engine (Phase 3) ---------------------------------------------
CORRELATION_ENABLED=true
# Related alerts within this window group into one incident
CORRELATION_WINDOW_SECONDS=300
# Sum of matching rule weights required to join an existing incident
CORRELATION_MIN_MATCH_SCORE=3.0
CORRELATION_WEIGHT_SAME_KEY=5.0
CORRELATION_WEIGHT_SAME_DEVICE_INTERFACE=4.0
CORRELATION_WEIGHT_SAME_DEVICE_EVENT_TYPE=3.5
CORRELATION_WEIGHT_SAME_DEVICE_SUBSYSTEM=3.0
CORRELATION_WEIGHT_CAUSAL_CHAIN=3.0
CORRELATION_WEIGHT_SHARED_ENDPOINT=3.5
CORRELATION_WEIGHT_CROSS_DEVICE_SAME_TYPE=2.0
# Hostname keywords that mark business-critical devices (scoring boost)
CORRELATION_CRITICAL_DEVICE_KEYWORDS=core,edge,aggregation,gateway,firewall,router,rtr
# Incident scoring weights
CORRELATION_SCORE_ALERT_WEIGHT=3.0
CORRELATION_SCORE_SEVERITY_WEIGHT=10.0
CORRELATION_SCORE_FREQUENCY_WEIGHT=4.0
CORRELATION_SCORE_DEVICE_IMPORTANCE_WEIGHT=15.0
CORRELATION_SCORE_EVENT_TYPE_WEIGHT=8.0
CORRELATION_SCORE_DURATION_WEIGHT=0.2

# Published ports (docker compose host-side) ---------------------------
SYSLOG_HOST_PORT=514
BACKEND_PORT=8000
FRONTEND_PORT=3000
